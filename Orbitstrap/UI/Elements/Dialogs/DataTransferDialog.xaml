<base:WpfUiWindow
    x:Class="Orbitstrap.UI.Elements.Dialogs.DataTransferDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:Orbitstrap.UI.Elements.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Orbitstrap.UI.Elements.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:Orbitstrap.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static resources:Strings.Dialog_DataTransfer_Title}"
    Width="480"
    MinHeight="30"
    Background="{ui:ThemeResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    SizeToContent="Height"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                <GradientStop Offset="0.00" Color="{DynamicResource WindowBackgroundColorPrimary}"/>
                <GradientStop Offset="0.90" Color="{DynamicResource WindowBackgroundColorSecondary}"/>
                <GradientStop Offset="1.10" Color="{DynamicResource WindowBackgroundColorThird}"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Title Bar  -->
        <ui:TitleBar
            Title="{x:Static resources:Strings.Dialog_DataTransfer_Title}"
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Padding="9"
            CanMaximize="False"
            KeyboardNavigation.TabNavigation="None"
            ShowMaximize="False"
            ShowMinimize="False" />

        <!--  Options  -->
        <StackPanel Grid.Row="1" Margin="18,12,18,6">
            <TextBlock
                Margin="0,0,0,10"
                FontSize="13"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{x:Static resources:Strings.Dialog_DataTransfer_ChooseWhatToExport}"
                TextWrapping="Wrap" />

            <RadioButton
                x:Name="AllDataRadio"
                Margin="0,2,0,8"
                Checked="ScopeRadio_Checked"
                Content="{x:Static resources:Strings.Dialog_DataTransfer_AllData}"
                GroupName="ExportScope"
                IsChecked="True" />

            <TextBlock
                Margin="24,-4,0,8"
                FontSize="12"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                Text="{x:Static resources:Strings.Dialog_DataTransfer_AllDataDescription}"
                TextWrapping="Wrap" />

            <RadioButton
                x:Name="CustomRadio"
                Margin="0,4,0,4"
                Checked="ScopeRadio_Checked"
                Content="{x:Static resources:Strings.Dialog_DataTransfer_Custom}"
                GroupName="ExportScope" />

            <StackPanel
                x:Name="CustomOptions"
                Margin="24,4,0,0"
                IsEnabled="False">
                <CheckBox
                    x:Name="ModsCheck"
                    Margin="0,4,0,0"
                    Content="{x:Static resources:Strings.Dialog_DataTransfer_Mods}"
                    IsChecked="True" />
                <CheckBox
                    x:Name="FastFlagsCheck"
                    Margin="0,4,0,0"
                    Content="{x:Static resources:Strings.Dialog_DataTransfer_FastFlags}"
                    IsChecked="True" />
                <CheckBox
                    x:Name="SettingsCheck"
                    Margin="0,4,0,0"
                    Content="{x:Static resources:Strings.Dialog_DataTransfer_Settings}"
                    IsChecked="True" />
                <CheckBox
                    x:Name="GlobalSettingsCheck"
                    Margin="0,4,0,0"
                    Content="{x:Static resources:Strings.Dialog_DataTransfer_GlobalSettings}"
                    IsChecked="True" />
            </StackPanel>
        </StackPanel>

        <!--  Bottom Action Buttons  -->
        <Border
            Grid.Row="2"
            Margin="0,10,0,0"
            Padding="15"
            Background="{DynamicResource PrimaryBackgroundColor}">
            <StackPanel
                HorizontalAlignment="Right"
                FlowDirection="LeftToRight"
                Orientation="Horizontal">

                <Button
                    Width="100"
                    MinWidth="100"
                    Click="OKButton_Click"
                    Content="{x:Static resources:Strings.Common_OK}" />

                <Button
                    MinWidth="100"
                    Margin="12,0,0,0"
                    Content="{x:Static resources:Strings.Common_Cancel}"
                    IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</base:WpfUiWindow>