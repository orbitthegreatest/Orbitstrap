<ui:UiPage
    x:Class="Orbitstrap.UI.Elements.Settings.Pages.ModsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Orbitstrap.UI.Elements.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Orbitstrap.UI.ViewModels"
    xmlns:pages="clr-namespace:Orbitstrap.UI.Elements.Settings.Pages"
    xmlns:resources="clr-namespace:Orbitstrap.Resources"
    xmlns:conv="clr-namespace:Orbitstrap.Converters"
    xmlns:settings="clr-namespace:Orbitstrap.UI.ViewModels.Settings"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="ModsPage"
    d:DataContext="{d:DesignInstance Type=settings:ModsViewModel}"
    d:DesignHeight="4000"
    d:DesignWidth="800"
    Scrollable="True"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>
        <conv:EnumNotEqualsVisibilityConverter x:Key="EnumNotEqualsVisibilityConverter"/>
    </Page.Resources>

    <StackPanel Margin="0,0,14,14">
        <TextBlock
            FontSize="14"
            Foreground="{StaticResource TextFillColorSecondaryBrush}"
            Text="{x:Static resources:Strings.Menu_Mods_Description}"
            TextWrapping="Wrap" />

        <!--  Grid for Cards  -->
        <Grid Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Open Mods Folder Card  -->
            <ui:CardAction Grid.Row="0" Grid.Column="1" x:Name="OpenModFolderCardAction" Margin="4,0,0,0" Icon="Folder24" Command="{Binding OpenModsFolderCommand}">
                <StackPanel>
                    <TextBlock FontSize="14" Text="{x:Static resources:Strings.Menu_Mods_OpenModsFolder_Title}" TextWrapping="Wrap" FontWeight="Medium" />
                    <TextBlock Margin="0,2,0,0" FontSize="12" Text="{x:Static resources:Strings.Menu_Mods_OpenModsFolder_Description}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </ui:CardAction>

            <!--  Help Card  -->
            <ui:CardAction Grid.Row="0" Grid.Column="0" Margin="0,0,4,0" Icon="BookQuestionMark24" Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://github.com/Bloxstraplabs/Bloxstrap/wiki/Adding-custom-mods">
                <StackPanel>
                    <TextBlock FontSize="14" Text="{x:Static resources:Strings.Common_Help}" FontWeight="Medium" />
                    <TextBlock Margin="0,2,0,0" FontSize="12" Text="{x:Static resources:Strings.Menu_Mods_Help_Description}" Padding="0,0,16,0"  Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </ui:CardAction>

            <!--  Compatibility Settings Card  -->
            <ui:CardAction
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Margin="0,7,0,0"
                VerticalAlignment="Top"
                Command="{Binding OpenCompatSettingsCommand}"
                Icon="WindowWrench24">
                <StackPanel>
                    <TextBlock
                        FontSize="14"
                        Text="{x:Static resources:Strings.Menu_Mods_Misc_CompatibilitySettings_Title}"
                        TextWrapping="Wrap" FontWeight="Medium" />
                    <controls:MarkdownTextBlock
                        Margin="0,2,0,0"
                        FontSize="12"
                        Foreground="{StaticResource TextFillColorTertiaryBrush}"
                        MarkdownText="{Binding Source={x:Static resources:Strings.Menu_Mods_Misc_CompatibilitySettings_Description}, Converter={StaticResource StringFormatConverter}, ConverterParameter='https://devblogs.microsoft.com/directx/demystifying-full-screen-optimizations/'}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ui:CardAction>


        </Grid>


        <TabControl Margin="0,16,0,0">
            <TabItem Header="Preset Mod" FontWeight="Medium" >
                <StackPanel Margin="12,12,12,12" Height="Auto">

                    <TextBlock
            FontSize="20"
            FontWeight="Bold"
            Margin="0,0,0,16"
            Text="{x:Static resources:Strings.Common_Presets}" />

                    <ui:CardExpander IsExpanded="False" Margin="0,8,0,0">
                        <ui:CardExpander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontSize="14.4" Text="UI Overlays" />
                                    <TextBlock
                            Margin="0,2,0,0"
                            FontSize="12"
                            Foreground="{StaticResource TextFillColorTertiaryBrush}"
                            Text="Configure UI overlays and Custom Crosshair overlay" />
                                </StackPanel>
                            </Grid>
                        </ui:CardExpander.Header>

                        <StackPanel>

                            <ui:CardExpander IsExpanded="False" Header="Custom Crosshair">
                                <StackPanel>

                                    <ui:CardAction
            Grid.Row="0"
            Grid.Column="0"
            Icon="CursorHover24"
            Command="models:GlobalViewModel.OpenWebpageCommand"
            CommandParameter="https://orbitstrapp.netlify.app/crosshairs/crosshairs">

                                        <StackPanel>
                                            <TextBlock
                    FontSize="14"
                    Text="Crosshair Codes"
                    FontWeight="Medium" />

                                            <TextBlock
                    Margin="0,2,0,0"
                    FontSize="12"
                    Text="Find Crosshairs you would like to use!"
                    Padding="0,0,16,0"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    TextWrapping="Wrap" />
                                        </StackPanel>
                                    </ui:CardAction>

                                    <controls:OptionControl Header="Crosshair">
                                        <ui:ToggleSwitch IsChecked="{Binding Crosshair, Mode=TwoWay}" />
                                    </controls:OptionControl>

                                    <controls:OptionControl Header="Cursor Shape" Description="Select crosshair shape.">
                                        <ComboBox Width="160"
                      ItemsSource="{Binding CrosshairShapes}"
                      SelectedItem="{Binding SelectedShape, Mode=TwoWay}" />
                                    </controls:OptionControl>

                                    <controls:OptionControl
            Header="GIF Crosshair"
            Description="Use an animated GIF URL as your crosshair."
            Visibility="{Binding SelectedShape, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Image}">

                                        <StackPanel>
                                            <TextBox
                    Width="260"
                    Text="{Binding ImageUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                        </StackPanel>
                                    </controls:OptionControl>

                                    <controls:OptionControl
            Header="Cursor Color"
            Description="Set the main cursor color (HEX)."
            Visibility="{Binding SelectedShape, Converter={StaticResource EnumNotEqualsVisibilityConverter}, ConverterParameter=Image}">

                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBox Width="120"
                         Text="{Binding CursorColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <ui:Button Content="Pick"
                           Command="{Binding PickCursorColorCommand}"
                           Margin="4,0,0,0" />
                                        </StackPanel>
                                    </controls:OptionControl>

                                    <controls:OptionControl
            Header="Cursor Outline"
            Description="Set the cursor outline color (HEX)."
            Visibility="{Binding SelectedShape, Converter={StaticResource EnumNotEqualsVisibilityConverter}, ConverterParameter=Image}">

                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBox Width="120"
                         Text="{Binding CursorOutlineColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <ui:Button Content="Pick"
                           Command="{Binding PickOutlineColorCommand}"
                           Margin="4,0,0,0" />
                                        </StackPanel>
                                    </controls:OptionControl>

                                    <controls:OptionControl Header="Cursor Size" Description="Adjust the cursor size.">
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <Slider Width="200"
                        Minimum="4"
                        Maximum="64"
                        Value="{Binding CursorSize, Mode=TwoWay}" />
                                            <TextBlock Text="{Binding CursorSize}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center" />
                                        </StackPanel>
                                    </controls:OptionControl>

                                    <controls:OptionControl
            Header="Line Thickness"
            Description="Adjust crosshair thickness."
            Visibility="{Binding SelectedShape, Converter={StaticResource EnumNotEqualsVisibilityConverter}, ConverterParameter=Image}">

                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <Slider Width="200"
                        Minimum="1"
                        Maximum="10"
                        Value="{Binding CrosshairThickness, Mode=TwoWay}" />
                                            <TextBlock Text="{Binding CrosshairThickness}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center" />
                                        </StackPanel>
                                    </controls:OptionControl>

                                    <controls:OptionControl
            Header="Center Gap"
            Description="Gap from the center."
            Visibility="{Binding SelectedShape, Converter={StaticResource EnumNotEqualsVisibilityConverter}, ConverterParameter=Image}">

                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <Slider Width="200"
                        Minimum="0"
                        Maximum="32"
                        Value="{Binding Gap, Mode=TwoWay}" />
                                            <TextBlock Text="{Binding Gap}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center" />
                                        </StackPanel>
                                    </controls:OptionControl>

                                    <controls:OptionControl Header="Opacity" Description="Adjust crosshair opacity.">
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <Slider Width="200"
                        Minimum="0.1"
                        Maximum="1.0"
                        Value="{Binding CursorOpacity, Mode=TwoWay}" />
                                            <TextBlock Text="{Binding CursorOpacity}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center" />
                                        </StackPanel>
                                    </controls:OptionControl>

                                    <controls:OptionControl Header="Preview" Description="Live preview of your crosshair.">
                                        <Border Width="208"
                    Height="208"
                    BorderThickness="1"
                    BorderBrush="Gray"
                    CornerRadius="4">
                                            <Image Source="{Binding CursorPreview}"
                       Stretch="Uniform" />
                                        </Border>
                                    </controls:OptionControl>

                                    <controls:OptionControl Header="Cursor Code" Description="Share or import crosshair codes.">
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBox Width="220"
                         Text="{Binding CursorCode, Mode=TwoWay}" />
                                            <ui:Button Content="Generate"
                           Command="{Binding GenerateCursorCodeCommand}"
                           Margin="4,0,0,0" />
                                            <ui:Button Content="Apply"
                           Command="{Binding ApplyCursorCodeCommand}"
                           Margin="4,0,0,0" />
                                        </StackPanel>
                                    </controls:OptionControl>

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="Download .CUR" Margin="0,0,5,0"
            Command="{Binding DownloadCurCommand}"
            Height="35"/>
                                        <Button Content="Download .PNG"
            Command="{Binding DownloadPngCommand}"
            Height="35"/>
                                    </StackPanel>
                                </StackPanel>
                            </ui:CardExpander>
                            

                            <ui:CardExpander Margin="0,8,0,0" IsExpanded="False" Header="Custom UI Mods">
                                <StackPanel>

                                    <controls:OptionControl Header="Enable Overlay" Description="Enables the Overlay Mods to work over Roblox.">
                                        <ui:ToggleSwitch IsChecked="{Binding OverlaysEnabled, Mode=TwoWay}" />
                                    </controls:OptionControl>

                                    <controls:OptionControl Header="Windows FPS Counter" Description="Displays your computer's FPS.">
                                        <ui:ToggleSwitch IsChecked="{Binding FPSCounter, Mode=TwoWay}" />
                                    </controls:OptionControl>

                                    <controls:OptionControl Header="Current Time" Description="Displays the current system time.">
                                        <ui:ToggleSwitch IsChecked="{Binding CurrentTimeDisplay, Mode=TwoWay}" />
                                    </controls:OptionControl>

                                    <controls:OptionControl Header="Brightness" 
                        Description="Adjust the screen brightness level">

                                        <StackPanel>
                                            <Slider Minimum="0"
                Maximum="100"
                Value="{Binding Brightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TickFrequency="5"
                IsSnapToTickEnabled="True"/>

                                            <TextBlock Grid.Column="1"
           VerticalAlignment="Center"
           HorizontalAlignment="Right"
           Text="{Binding BrightnessDisplay}"/>
                                        </StackPanel>

                                    </controls:OptionControl>
                                    
                                    <controls:OptionControl 
    Header="Lighting Changer (BETA)" 
Description="Adds a Experimental overlay-based lighting changer. Customize your Roblox lighting."
>
                                        <ui:ToggleSwitch IsChecked="{Binding MotionBlurOverlayEnabled, Mode=TwoWay}" />
                                    </controls:OptionControl>

                                </StackPanel>
                            </ui:CardExpander>
                        </StackPanel>
                    </ui:CardExpander>

                    <controls:OptionControl Description="{x:Static resources:Strings.Menu_Mods_Presets_OldAvatarEditor_Description}" Header="{x:Static resources:Strings.Menu_Mods_Presets_OldAvatarEditor_Title}">
                        <ui:ToggleSwitch IsChecked="{Binding OldAvatarBackgroundTask.NewState, Mode=TwoWay}" />
                    </controls:OptionControl>

                    <controls:OptionControl Description="{x:Static resources:Strings.Menu_Mods_Presets_OldCharacterSounds_Description}" Header="{x:Static resources:Strings.Menu_Mods_Presets_OldCharacterSounds_Title}">
                        <ui:ToggleSwitch IsChecked="{Binding OldCharacterSoundsTask.NewState, Mode=TwoWay}" />
                    </controls:OptionControl>

                    <!-- Avatar mods -->
                    <controls:OptionControl
                        Header="Korblox Right Leg"
                        Description="Replace your right leg with the Korblox skeleton leg mesh. Requires an internet connection the first time it is enabled; the mesh is cached locally after that. Roblox must be relaunched for changes to take effect.">
                        <ui:ToggleSwitch IsChecked="{Binding UseKorbloxRightLeg, Mode=TwoWay}" />
                    </controls:OptionControl>

                    <controls:OptionControl
                        Header="Headless"
                        Description="Make your avatar appear headless by removing all head meshes. Disable to restore the default heads (requires an internet connection the first time; cached locally after that). Roblox must be relaunched for changes to take effect.">
                        <ui:ToggleSwitch IsChecked="{Binding UseHeadlessMod, Mode=TwoWay}" />
                    </controls:OptionControl>

                    <controls:OptionControl Description="Attempt to recreate Fullbright without FFlags. Not effective when Lighting FFlags are used." Header="FullBright">
                        <ui:ToggleSwitch IsChecked="{Binding Fullbright, Mode=TwoWay}" />
                    </controls:OptionControl>

                    <!-- Texture mods -->
                    <controls:OptionControl
                        Header="Dark Textures"
                        Description="Replace default Roblox textures with dark, high-contrast variants. Downloads ~50MB on first enable; cached locally after that. Roblox must be relaunched for changes to take effect.">
                        <ui:ToggleSwitch IsChecked="{Binding UseDarkTextureMod, Mode=TwoWay}" />
                    </controls:OptionControl>

                    <!-- Cursor mods -->

                    <TextBlock Text="Mouse Cursor Preset" FontSize="20" FontWeight="Bold" Margin="0,16,0,0" />
                    <TextBlock Text="Select a cursor style from GitHub or upload your own. Choose 'Custom...' to pick files." TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ComboBox
                            Width="200"
                            Padding="10,5,10,5"
                            ItemsSource="{Binding AvailableCursorPresets}"
                            SelectedItem="{Binding SelectedCursorPreset, Mode=TwoWay}"
                            DisplayMemberPath="Name" />
                    </StackPanel>
                    <Image Source="{Binding CursorPresetPreview}" MaxWidth="200" MaxHeight="200" Margin="0,8,0,0" RenderOptions.BitmapScalingMode="HighQuality" />

                    <!-- Custom cursor Browse UI -->
                    <StackPanel Visibility="{Binding IsCursorCustomSelected, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" Margin="0,8,0,0">
                        <TextBlock Text="Upload your own cursor files:" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ShiftLock" VerticalAlignment="Center" Width="120"/>
                            <TextBlock Grid.Column="1" Text="{Binding CustomCursorShiftlockDisplay}" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <ui:Button Grid.Column="2" Content="Browse" Command="{Binding BrowseShiftlockCommand}" Padding="12,4"/>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Arrow Cursor" VerticalAlignment="Center" Width="120"/>
                            <TextBlock Grid.Column="1" Text="{Binding CustomCursorArrowDisplay}" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <ui:Button Grid.Column="2" Content="Browse" Command="{Binding BrowseArrowCursorCommand}" Padding="12,4"/>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ArrowFar Cursor" VerticalAlignment="Center" Width="120"/>
                            <TextBlock Grid.Column="1" Text="{Binding CustomCursorArrowFarDisplay}" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <ui:Button Grid.Column="2" Content="Browse" Command="{Binding BrowseArrowFarCursorCommand}" Padding="12,4"/>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="IBeam Cursor" VerticalAlignment="Center" Width="120"/>
                            <TextBlock Grid.Column="1" Text="{Binding CustomCursorIBeamDisplay}" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <ui:Button Grid.Column="2" Content="Browse" Command="{Binding BrowseIBeamCursorCommand}" Padding="12,4"/>
                        </Grid>
                    </StackPanel>

                    <TextBlock Text="Font Preset" FontSize="20" FontWeight="Bold" Margin="0,16,0,0" />
                    <TextBlock Text="Select a font style from GitHub or upload your own. Choose 'Custom...' to pick a file." TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ComboBox
                            Width="200"
                            Padding="10,5,10,5"
                            ItemsSource="{Binding AvailableFontPresets}"
                            SelectedItem="{Binding SelectedFontPreset, Mode=TwoWay}"
                            DisplayMemberPath="Name" />
                    </StackPanel>
                    <Image Source="{Binding FontPresetPreview}" MaxWidth="200" MaxHeight="200" Margin="0,8,0,0" RenderOptions.BitmapScalingMode="HighQuality" />

                    <TextBlock Text="Death Sound Preset" FontSize="20" FontWeight="Bold" Margin="0,16,0,0" />
                    <TextBlock Text="Select a death sound from GitHub or upload your own. Choose 'Custom...' to pick a file." TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ComboBox
                            Width="200"
                            Padding="10,5,10,5"
                            ItemsSource="{Binding AvailableDeathSoundPresets}"
                            SelectedItem="{Binding SelectedDeathSoundPreset, Mode=TwoWay}"
                            DisplayMemberPath="Name" />
                    </StackPanel>

                    <controls:OptionControl Description="{x:Static resources:Strings.Menu_Mods_Presets_EmojiType_Description}" Header="{x:Static resources:Strings.Menu_Mods_Presets_EmojiType_Title}">
                        <ComboBox
                Width="220"
                Margin="5,0,0,0"
                Padding="10,5,10,5"
                ItemsSource="{Binding EmojiFontTask.Selections, Mode=OneTime}"
                Text="{Binding EmojiFontTask.NewState, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </controls:OptionControl>

                    <!-- UI replacement mods -->
                    <controls:OptionControl
                        Header="Emote Wheel Selector"
                        Description="Replace the emote wheel menu with a custom themed design. Downloads the selected wheel from the Orbitstrap-things asset repo and installs it into your Mods folder. Pick &quot;None (Default)&quot; to restore the stock wheel. Requires an internet connection the first time a wheel is selected, and Roblox must be relaunched for changes to take effect.">
                        <ComboBox MinWidth="160" VerticalAlignment="Center"
                                  ItemsSource="{Binding EmoteWheelOptions}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedEmoteWheelId, Mode=TwoWay}" />
                    </controls:OptionControl>

                    <TextBlock
            Margin="0,16,0,0"
            FontSize="20"
            FontWeight="Bold"
            Text="{x:Static resources:Strings.Common_Miscellaneous}" />

                    <controls:OptionControl
    Header="Skybox Manager"
    Description="Select a custom Roblox skybox to use. Works best in games without an existing skybox.">

                        <StackPanel Orientation="Vertical">

                            <ComboBox
            ItemsSource="{Binding AvailableSkyboxPacks}"
            SelectedItem="{Binding SelectedSkyboxPack, Mode=TwoWay}"
            DisplayMemberPath="Name"
            Width="200"
            Margin="0,0,0,5"/>

                            <ui:ToggleSwitch
            IsChecked="{Binding SkyboxEnabled, Mode=TwoWay}"
            HorizontalAlignment="Right"
            Margin="0,6,0,0"/>

                        </StackPanel>

                    </controls:OptionControl>
                </StackPanel>
            </TabItem>

        </TabControl>
    </StackPanel>
</ui:UiPage>