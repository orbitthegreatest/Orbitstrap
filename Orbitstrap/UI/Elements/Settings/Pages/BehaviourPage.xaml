<ui:UiPage
    x:Class="Orbitstrap.UI.Elements.Settings.Pages.BehaviourPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Orbitstrap.UI.Elements.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Orbitstrap.UI.ViewModels.Settings"
    xmlns:resources="clr-namespace:Orbitstrap.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Deployment"
    d:DataContext="{d:DesignInstance Type=models:BehaviourViewModel}"
    d:DesignHeight="2000"
    d:DesignWidth="800"
    Scrollable="True"
    mc:Ignorable="d">

    <StackPanel Margin="0,0,14,14">

        <TextBlock
            Margin="0,0,0,8"
            FontSize="14"
            Foreground="{StaticResource TextFillColorSecondaryBrush}"
            Text="Configure how Roblox launches, performs, and manages server connections." />

        <!-- ============================================================ -->
        <!-- SERVER MATCHING                                               -->
        <!-- ============================================================ -->
        <TextBlock
            Margin="0,16,0,0"
            FontSize="16"
            FontWeight="Medium"
            Text="Server Matching" />

        <controls:OptionControl
            Margin="0,8,0,0"
            Header="Enable BetterMatchmaking"
            Description="Improves server selection by filtering low-quality or lagging servers before joining.">
            <ui:ToggleSwitch IsChecked="{Binding IsBetterServersEnabled, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="Randomize BetterMatchmaking Server"
            Description="When BetterMatchmaking is on, pick a random high-quality server instead of always the best one. Helps spread load and avoids predictable joins.">
            <ui:ToggleSwitch IsChecked="{Binding RandomizeBetterMatchmaking, Mode=TwoWay}" />
        </controls:OptionControl>

        <!-- ============================================================ -->
        <!-- LAUNCH OPTIONS                                                -->
        <!-- ============================================================ -->
        <TextBlock
            Margin="0,16,0,0"
            FontSize="16"
            FontWeight="Medium"
            Text="Launch Options" />

        <controls:OptionControl
            Margin="0,8,0,0"
            Header="{x:Static resources:Strings.Menu_Behaviour_ConfirmLaunches_Title}"
            Description="{x:Static resources:Strings.Menu_Behaviour_ConfirmLaunches_Description}">
            <ui:ToggleSwitch IsChecked="{Binding ConfirmLaunches, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_Behaviour_ForceRobloxLanguage_Title}"
            Description="{x:Static resources:Strings.Menu_Behaviour_ForceRobloxLanguage_Description}">
            <ui:ToggleSwitch IsChecked="{Binding ForceRobloxLanguage, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="Multi-Instance Launching"
            Description="Allow multiple Roblox instances to run simultaneously on the same machine.">
            <ui:ToggleSwitch IsChecked="{Binding MultiInstanceLaunching, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="Multi-Account Support"
            Description="Enable launching Roblox with different accounts at the same time.">
            <ui:ToggleSwitch IsChecked="{Binding MultiAccount, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="Background Window"
            Description="Keep Roblox running in the background when the window is minimised.">
            <ui:ToggleSwitch IsChecked="{Binding BackgroundWindow, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="Error 773 Fix"
            Description="Apply a workaround for the Roblox Error 773 (game session expired) crash.">
            <ui:ToggleSwitch IsChecked="{Binding Error773Fix, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="Disable Crash Handler"
            Description="Bypass Roblox's built-in crash reporter. Enable only for debugging purposes.">
            <ui:ToggleSwitch IsChecked="{Binding disablecrashhandleryayyysocool, Mode=TwoWay}" />
        </controls:OptionControl>

        <!-- ============================================================ -->
        <!-- PERFORMANCE                                                   -->
        <!-- ============================================================ -->
        <TextBlock
            Margin="0,16,0,0"
            FontSize="16"
            FontWeight="Medium"
            Text="Performance" />

        <controls:OptionControl
            Margin="0,8,0,0"
            Header="CPU Thread Priority"
            Description="Limit which CPU threads Roblox is allowed to use. 'Automatic' lets the OS decide.">
            <ComboBox
                Width="200"
                Margin="8,0,8,0"
                Padding="10,5,10,5"
                ItemsSource="{Binding CpuOptions}"
                SelectedItem="{Binding SelectedCpuPriority, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="Optimise Roblox"
            Description="Apply general Roblox process optimisations for better frame stability and reduced memory usage.">
            <ui:ToggleSwitch IsChecked="{Binding OptimizeRoblox, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="Overclock CPU"
            Description="Boost Roblox process priority to High on the CPU. May improve performance but can affect other running applications.">
            <ui:ToggleSwitch IsChecked="{Binding OverClockCPU, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="Overclock GPU"
            Description="Hint to Windows that Roblox should prefer the high-performance GPU on hybrid systems.">
            <ui:ToggleSwitch IsChecked="{Binding OverClockGPU, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="Exclusive Fullscreen"
            Description="Run Roblox in exclusive fullscreen mode for lower input latency. Note: this disables overlays (Discord, Steam, etc.).">
            <ui:ToggleSwitch IsChecked="{Binding ExclusiveFullscreen, Mode=TwoWay}" />
        </controls:OptionControl>

        <!-- ============================================================ -->
        <!-- MEMORY CLEANER                                                -->
        <!-- ============================================================ -->
        <TextBlock
            Margin="0,16,0,0"
            FontSize="16"
            FontWeight="Medium"
            Text="Memory Cleaner" />

        <controls:OptionControl
            Margin="0,8,0,0"
            Header="Auto-Clean Interval"
            Description="How often Orbitstrap should automatically flush old cache and log files while Roblox is running.">
            <ComboBox
                Width="220"
                Margin="8,0,8,0"
                Padding="10,5,10,5"
                DisplayMemberPath="Name"
                ItemsSource="{Binding MemoryCleanerIntervals}"
                SelectedItem="{Binding SelectedMemoryCleanerInterval, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="Clean Roblox Logs"
            Description="Include Roblox log files in the auto-clean cycle.">
            <ui:ToggleSwitch IsChecked="{Binding CleanerLogs, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="Clean Roblox Cache"
            Description="Include Roblox's local content cache in the auto-clean cycle.">
            <ui:ToggleSwitch IsChecked="{Binding CleanerCache, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="Clean Orbitstrap Logs"
            Description="Include Orbitstrap's own log files in the auto-clean cycle.">
            <ui:ToggleSwitch IsChecked="{Binding CleanerOrbitstrap, Mode=TwoWay}" />
        </controls:OptionControl>

        <!-- ============================================================ -->
        <!-- EXTRAS                                                        -->
        <!-- ============================================================ -->
        <TextBlock
            Margin="0,16,0,0"
            FontSize="16"
            FontWeight="Medium"
            Text="Extras" />

        <controls:OptionControl
            Margin="0,8,0,0"
            Header="Rename Client to Euro Trucks 2"
            Description="Rename the Roblox process name to EuroTrucks2.exe. Useful for bypassing certain game blocks.">
            <ui:ToggleSwitch IsChecked="{Binding RenameClientToEurotrucks2, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="Game Mode"
            Description="Enable Windows Game Mode optimisations for the Roblox process.">
            <ui:ToggleSwitch IsChecked="{Binding IsGameEnabled, Mode=TwoWay}" />
        </controls:OptionControl>

    </StackPanel>
</ui:UiPage>
